# Local default; replace with the public HTTPS URL of the AWS backend when building.
VITE_API_BASE_URL=http://localhost:8080/api

# Vercel server-side proxy target. Set this in Vercel to the Render service
# origin without /api, for example https://your-service.onrender.com.
BACKEND_API_URL=https://your-service.onrender.com
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,https://networkers.family,https://www.networkers.family
